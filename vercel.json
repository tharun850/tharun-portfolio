{
  "installCommand": "npm install --include=dev && npm --prefix frontend install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist/portfolio-frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
