# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# Resend (https://resend.com/api-keys) — free tier: 3,000 emails/mo, 100/day,
# no credit card required. FROM_EMAIL must be on a domain you've verified
# in Resend (Domains tab), or use their shared onboarding@resend.dev sender
# for testing only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@yourdomain.com
TO_EMAIL=you@example.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Free, unlimited assessments, no billing account required.
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
