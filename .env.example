# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# 1. Resend Email Service (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev
TO_EMAIL=your_email@example.com

# 2. Cloudflare Turnstile Keys (https://dash.cloudflare.com/?to=/:account/turnstile)
# Secret key used by backend/serverless API:
TURNSTILE_SECRET_KEY=0x4_your_turnstile_secret_key_here
# Site key used by frontend widget:
PUBLIC_TURNSTILE_SITE_KEY=0x4_your_turnstile_site_key_here
